# ---- บริการ API (apps/api) ----
# ผู้ดูแลฐานข้อมูล — ใช้รัน migration เท่านั้น
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/duly

# รหัสผ่านของ role duly_app ที่ตัวรัน migration จะสร้างให้ (อย่างน้อย 16 ตัวอักษร)
APP_DB_PASSWORD=

# ผู้ใช้ที่แอปเชื่อมจริง — จำกัดสิทธิ์และถูก Row Level Security บังคับ
# ถ้าไม่ตั้ง จะย้อนไปใช้ DATABASE_URL ซึ่งไม่ควรทำบนเครื่องจริง
APP_DATABASE_URL=postgresql://duly_app:APP_DB_PASSWORD@localhost:5432/duly

# ตั้งเป็น require ถ้าฐานข้อมูลบังคับ TLS แต่ใบรับรองเป็นแบบภายใน
# DATABASE_SSL=require

PORT=3001
DB_POOL_MAX=10
# CORS_ORIGIN=https://your-domain.up.railway.app

# ---- บริการหน้าเว็บ (apps/web) ----
# ชี้ไปที่บริการ API ผ่านเครือข่ายภายในของ Railway
# API_URL=http://duly-api.railway.internal:3001
